# Public
# Optional — get a free ID at https://cloud.reown.com (leave empty for MetaMask-only)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CIVILIZATION_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com

# Server
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Neon Postgres connection string. Required for local API routes and Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Required only for optional on-chain AI settlement. Never use a demo mnemonic in production.
AGENT_MNEMONIC=
OPERATOR_PRIVATE_KEY=
PRIVATE_KEY=
ENABLE_ONCHAIN=true
ENABLE_ONCHAIN_AI=false
DISABLE_SIM=false
SIM_TICK_MS=5000
PROD_TICK_MS=60000
# Used by GitHub Actions or Vercel Cron to call /api/cron/tick.
CRON_SECRET=
# Optional — powers interactive AI agent skills (gpt-5.4-nano by default).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
